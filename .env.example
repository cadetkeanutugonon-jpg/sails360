# Copy to .env.local and fill in. Never commit .env.local.
# Leave the Supabase values empty to run in labeled demo mode.

# Public (safe for the browser): from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Needed only for trusted server tasks such as creating the first admin.
SUPABASE_SERVICE_ROLE_KEY=
